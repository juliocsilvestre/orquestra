# Pastas de config de cada conta do Claude. Vazio = padrão (~/.claude).
CONTA1_DIR=""
CONTA2_DIR="$HOME/.claude-conta2"
BOSS_CONTA=1
DEV_EXTRA_CONTA=2
BOSS_CLAUDE_CONFIG_DIR="$CONTA1_DIR"
DEV_CLAUDE_CONFIG_DIR="$CONTA2_DIR"
# Branch base dos devs (vazio = automático: develop se existir, senão main)
BASE_BRANCH="${BASE_BRANCH:-}"
