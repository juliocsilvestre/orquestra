{
  "permissions": {
    "deny": [
      "Bash(*ok.sh*)",
      "Bash(cat .env.local:*)",
      "Bash(cat .env:*)",
      "Bash(docker compose up:*)",
      "Bash(env)",
      "Bash(gh:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git submodule:*)",
      "Bash(glab:*)",
      "Bash(make up:*)",
      "Bash(npm run dev:*)",
      "Bash(printenv:*)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*state*.json)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.hml)",
      "Read(**/.env.homolog)",
      "Read(**/.env.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.secrets/**)",
      "Bash(hc send:*)",
      "Bash(hc kill:*)",
      "Bash(hc run:*)",
      "Bash(hc keys:*)",
      "Bash(hc interrupt:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__ORQ__/estudio/hook.mjs\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}